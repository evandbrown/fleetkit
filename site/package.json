{
  "name": "fleetkit-site",
  "private": true,
  "version": "0.1.0",
  "description": "The fleetkit site: results, the experiment builder, and what we test and how.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "build": "vite build && node scripts/size-check.mjs",
    "preview": "node scripts/serve.mjs --dir dist --base /fleetkit/",
    "preview:fixtures": "node scripts/serve.mjs --dir dist --base /fleetkit/ --data tests/fixtures/data",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node tests/fixtures/make-synthetic.mjs"
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "22.20.4",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
