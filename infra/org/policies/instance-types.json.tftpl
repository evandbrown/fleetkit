{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInstanceTypesOutsideAllowlist",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:${partition}:ec2:*:*:instance/*",
      "Condition": {
        "StringNotEquals": {
          "ec2:InstanceType": ${jsonencode(allowed_instance_types)}
        }
      }
    },
    {
      "Sid": "DenyLaunchPathsThatBypassRunInstances",
      "Effect": "Deny",
      "Action": [
        "autoscaling:CreateAutoScalingGroup",
        "autoscaling:UpdateAutoScalingGroup",
        "ec2:CreateFleet",
        "ec2:ModifyFleet",
        "ec2:RequestSpotFleet",
        "ec2:RequestSpotInstances"
      ],
      "Resource": "*"
    }
  ]
}
