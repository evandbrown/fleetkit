# Copy to terraform.tfvars (gitignored). Everything else has a default; see variables.tf.

# The state bucket created by infra/bootstrap; this stack reads the project stack's
# outputs from it.
state_bucket = "fleetkit-tfstate-<management-account-id>"

# host_count             = 1            # 0 tears the hosts down, keeps the rest
# instance_type          = "m8i.xlarge"
# shutdown_after_minutes = 240
# repo_ref               = "main"       # branch, tag or commit the hosts check out
