# Keep secrets, state and raw transcripts out of this public repo.
.env
*.jsonl
transcripts-raw/
.DS_Store

# Terraform: state, plans, provider caches and anything that carries account-specific
# values. The committed *.example files show what the ignored files should contain.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
*.tfvars
*.tfvars.json
backend.hcl
*.tfbackend
.terraform/
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Python bytecode cache produced by compiling the Lambda source locally.
__pycache__/
*.pyc

# The private workspace (its own local git repo) and the private working agreement. Never committed.
private/
CLAUDE.local.md

# Evidence pulled down from the results bucket after an experiment.
results/
# Worktrees link these three to the main checkout. A pattern ending in / matches only a
# directory, never a link, so the links need their own anchored patterns.
/results
/harness/.venv
/site/node_modules
build/
# ...except the site's dataset builder, which is source. Its staging output stays ignored
# (caches are covered by __pycache__/ and .pytest_cache/). `make ignore-check` tests these rules.
!site/build/
site/build/.staging/
harness/.venv/
.pytest_cache/
*.egg-info/
fixture/dist/
tfplan*
*.tfplan

# Claude Code settings for this checkout (personal permission rules). Never committed.
.claude/settings.json
.claude/settings.local.json
