# Capacity experiment, baseline configuration. Pre-registered in docs/capacity-experiment.md:
# these values were fixed and committed before the run that uses them. Sourced by
# images/host/stage.sh (stage `capacity`). One KEY=VALUE per line, shell-sourceable.

# The densities to test, in order: a trial at density N starts N microVMs at once, one task each.
DENSITIES=1,2,4,8,12,16
# Boundary trials: extra trials at the last passing and the first failing density (3 trials each in total).
BOUNDARY_TRIALS=2
# Warm-up trials at density 1 before the ladder, excluded from results.
WARMUP=1
# Seconds of idle before every trial; the host's CPU during the wait is recorded.
SETTLE_S=10
# Host metrics rate (the host daemon samples at 1/METRICS_HZ seconds).
METRICS_HZ=5
# Guest per-process sampling interval during each task.
SAMPLE_INTERVAL_MS=200

# Pass criteria for every trial (plus: all microVMs ready, all tasks ok, verify-clean clean).
STEP_P50_TARGET_MS=1000
STEP_P95_TARGET_MS=2000
TASK_P95_TARGET_MS=5000

# Timeouts. Startup is reported, never judged, beyond this bound.
READY_TIMEOUT_S=180
STEP_TIMEOUT_MS=10000
TASK_TIMEOUT_MS=45000

# The known-good microVM shape from the validation runs.
VCPUS=2
MEM_MIB=2048

# Worker host. Public on-demand price, us-east-1, Linux, read from the AWS price list on
# 2026-09-27 (assumed for cost per task; not a measurement).
INSTANCE_TYPE_EXPECTED=m8i.4xlarge
PRICE_PER_HOUR=0.84672
# Support host (fixture and observability backend), reported separately.
SUPPORT_INSTANCE_TYPE=m8i.xlarge
SUPPORT_PRICE_PER_HOUR=0.21168

# One untimed density-1 trial with a screenshot after every step, for the filmstrip.
ILLUSTRATION=1
