# Pinned versions and digests of every third-party artefact the images and the
# experiment hosts fetch. One KEY=VALUE per line, unquoted, so this file is both
# shell-sourceable (`. images/lock.env`) and readable by infra/experiments/host.tf,
# which fills the host's cloud-config from it. To bump an entry, change the value
# and re-record the digest(s) that verify it, as described above each line.

# Firecracker release tag. Bump: pick a tag from
# https://github.com/firecracker-microvm/firecracker/releases and replace the two
# digests below with the contents of that release's *.tgz.sha256.txt assets.
FIRECRACKER_VERSION=v1.17.0
# sha256 of firecracker-<FIRECRACKER_VERSION>-x86_64.tgz, from the release's
# firecracker-<FIRECRACKER_VERSION>-x86_64.tgz.sha256.txt.
FIRECRACKER_X86_64_SHA256=06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558
# sha256 of firecracker-<FIRECRACKER_VERSION>-aarch64.tgz, from its .sha256.txt.
FIRECRACKER_AARCH64_SHA256=e351ebe4f7a16b5873bbd51005d2e6767103cff4d5ebc829df2d3f95a93e2256

# Firecracker's CI artefact bucket, path-style on purpose: the bucket name has
# dots, so the virtual-hosted form (spec.ccfc.min.s3.amazonaws.com) does not match
# the wildcard certificate and fails TLS. Bump: only if the project moves.
KERNEL_BASE_URL=https://s3.amazonaws.com/spec.ccfc.min
# Dated prefix under the bucket that holds one consistent set of CI artefacts
# (guest kernels, the Ubuntu rootfs the probe boots). Bump: list the bucket
# (`aws s3 ls s3://spec.ccfc.min/firecracker-ci/ --no-sign-request`), pick a
# newer prefix, then re-record both kernel digests below.
KERNEL_CI_PREFIX=firecracker-ci/20260923-6f82ac4cf331-0
# Guest kernel, fetched from <KERNEL_BASE_URL>/<KERNEL_CI_PREFIX>/<arch>/vmlinux-<KERNEL_VERSION>.
# Bump: pick a version that exists under the prefix; re-record both digests.
KERNEL_VERSION=6.18.48
# sha256 of x86_64/vmlinux-<KERNEL_VERSION>. The bucket publishes no checksums, so
# this was recorded on first download (`sha256sum`) and every later fetch verifies it.
KERNEL_X86_64_SHA256=9204218e8bcca6ac23848d74f45df2eb19d7f31e8277840a7d145a0df8b078d2
# sha256 of aarch64/vmlinux-<KERNEL_VERSION>, recorded the same way.
KERNEL_AARCH64_SHA256=a80108af80d9549b357ea7e00bd5c12f80686869541d135a8a67f6fe1ec3451e

# Container images, each pinned by its multi-architecture manifest digest so the
# same reference resolves identically on arm64 and amd64. Bump any of them with
# `docker buildx imagetools inspect <name>:<tag>` and copy the top-level digest.
# Guest base image (images/guest/Dockerfile).
DEBIAN_IMAGE=debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
# The fixture web server.
NGINX_IMAGE=nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
# The observability stack (collector, Tempo, Loki, Prometheus, Grafana in one).
LGTM_IMAGE=grafana/otel-lgtm:0.34.0@sha256:b966ea107831d526d9eb8fe4d2d86c9e5731392fad9dce8296bcf2072031f07c
# Base for the e2fsprogs container that packs the guest rootfs (mkfs.ext4 -d).
ALPINE_IMAGE=alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
